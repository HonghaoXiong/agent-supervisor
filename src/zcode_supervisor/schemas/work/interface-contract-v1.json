{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zsc.interface-contract/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "interface_id", "version", "producer", "consumers", "symbol_refs", "conventions", "preconditions", "postconditions", "compatibility", "checker_ids", "owner_decision_id", "owner_revision"],
  "properties": {
    "schema_version": {"const": "zsc.interface-contract/v1"},
    "interface_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "string", "minLength": 1},
    "producer": {"type": "object", "additionalProperties": false, "required": ["task_id", "version"], "properties": {"task_id": {"type": "string"}, "version": {"type": "string"}}},
    "consumers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["task_id", "expected_version"], "properties": {"task_id": {"type": "string"}, "expected_version": {"type": "string"}}}},
    "symbol_refs": {"type": "array", "items": {"type": "string"}},
    "conventions": {"type": "object", "additionalProperties": false, "required": ["data_shape", "units", "time", "state_identity", "ownership"], "properties": {
      "data_shape": {"type": ["string", "null"]},
      "units": {"$ref": "#/$defs/convention"},
      "time": {"$ref": "#/$defs/convention"},
      "state_identity": {"$ref": "#/$defs/convention"},
      "ownership": {"$ref": "#/$defs/convention"}
    }},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "postconditions": {"type": "array", "items": {"type": "string"}},
    "compatibility": {"type": "string"},
    "checker_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "owner_decision_id": {"type": "string", "minLength": 1},
    "owner_revision": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "convention": {"type": "object", "additionalProperties": false, "required": ["value", "reason"], "properties": {"value": {"type": ["string", "null"]}, "reason": {"type": ["string", "null"]}}}
  }
}
